DISCORD_TOKEN=your_draft_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_server_guild_id_here
SUPER_ADMINS=comma_separated_user_ids

# ─── Draft mode ──────────────────────────────────────────────────────────────
# college (default) = normal college draft from prospects.college.ts
# redraft           = re-draft current NFL players (prospects.redraft.ts,
#                     generate with: npm run gen-redraft)
# Switching requires a container rebuild; saved drafts from the other mode are
# not loaded (rank IDs are dataset-relative).
DRAFT_MODE=college

# ─── Ollama LLM (optional, for /trade-ai and /board-ai commands) ────────────
# Local Ollama: http://localhost:11434 (default)
# Ollama Cloud: https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Required for Ollama Cloud only (get from: ollama signin)
OLLAMA_API_KEY=
